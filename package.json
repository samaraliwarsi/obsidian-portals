  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^16.11.6",
    "@types/sortablejs": "^1.15.9",
    "esbuild": "^0.27.4",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^9.30.1",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^14.0.0",
    "jiti": "^2.6.1",
    "obsidian": "1.12.3",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.0"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/web": "^2.1.2",
    "sortablejs": "^1.15.0"
