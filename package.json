{
  "name": "portals",
  "version": "1.3.9",
  "description": "Obsidian plugin to create pinned folder trees for easier navigation",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build:css": "node build-css.js",
    "dev": "npm run build:css && node esbuild.config.mjs",
    "build": "npm run build:css && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "lint:css": "stylelint 'src/styles/**/*.css'"
  },
  "keywords": [],
  "author": "samaraliwarsi",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^16.11.6",
    "@types/sortablejs": "^1.15.9",
    "esbuild": "^0.27.4",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^9.30.1",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^14.0.0",
    "jiti": "^2.6.1",
    "obsidian": "1.11.0",
    "postcss": "^8.5.15",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.0"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/web": "^2.1.2",
    "sortablejs": "^1.15.0"
  }
}
